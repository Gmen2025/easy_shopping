{
  "expo": {
    "name": "AdduGenet EShop",
    "slug": "AdduGenet-eshop",
    "scheme": "addugeneteshop",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/addugenet1.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/addugenet1.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.addugenet.eshop",
      "buildNumber": "2",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We need your location to calculate shipping costs and provide relevant product recommendations.",
        "NSCameraUsageDescription": "This app uses the camera to upload product images and scan items.",
        "NSPhotoLibraryUsageDescription": "This app accesses your photo library to select and upload product images.",
        "NSPhotoLibraryAddUsageDescription": "This app saves product images to your photo library."
      },
      "icon": "./assets/addugenet1.png"
    },
    "android": {
      "package": "com.addugenet.eshop",
      "googleServicesFile": "./google-services.json",
      "icon": "./assets/addugenet1.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/addugenet1.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "stripePublishableKey": "",
      "stripeCurrency": "usd",
      "telebirrMockEnabled": false,
      "eas": {
        "projectId": "2aec4a7d-b158-4d0f-986d-f45acf95eff5"
      }
    },
    "plugins": [
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.addugenet.eshop"
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ]
    ]
  }
}
