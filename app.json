{
  "expo": {
    "name": "AdduGenet EShop",
    "slug": "AdduGenet-eshop",
    "scheme": "addugeneteshop",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/addugenet_icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.addugenet.eshop",
      "buildNumber": "2",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow AdduGenet EShop to use your location while the app is open to choose delivery or pickup locations, find nearby stores, and support rides and deliveries. You can enter an address instead.",
        "NSCameraUsageDescription": "Allow camera access to take photos you choose to upload, such as a profile, store, driver, product, or service-request photo.",
        "NSPhotoLibraryUsageDescription": "Allow photo-library access to choose photos or videos you want to upload for a profile, store, driver, product, or service request."
      },
      "icon": "./assets/addugenet_icon.png"
    },
    "android": {
      "package": "com.addugenet.eshop",
      "googleServicesFile": "./google-services.json",
      "icon": "./assets/addugenet_icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/addugenet_icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "stripePublishableKey": "",
      "stripeCurrency": "usd",
      "telebirrMockEnabled": false,
      "socketUrl": "https://easy-shop-server-wldr.onrender.com",
      "eas": {
        "projectId": "2aec4a7d-b158-4d0f-986d-f45acf95eff5"
      }
    },
    "plugins": [
      "expo-status-bar",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.addugenet.eshop"
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ]
    ]
  }
}
