# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Firebase
GoogleService-Info.plist

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# Native build artifacts (.easignore replaces .gitignore, so android/.gitignore is not applied)
android/.gradle/
android/.kotlin/
android/.idea/
android/build/
android/app/build/
android/app/.cxx/
android/local.properties
**/.cxx/
*.hprof
*.iml